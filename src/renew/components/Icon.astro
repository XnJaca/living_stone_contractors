  close: 'M6 6l12 12M18 6L6 18',
  quote: 'M10 8H6.5A1.5 1.5 0 0 0 5 9.5V13h5V8zM10 13c0 3-1.5 4.5-4 5M19 8h-3.5A1.5 1.5 0 0 0 14 9.5V13h5V8zM19 13c0 3-1.5 4.5-4 5',
