---
// Architectural dimension line that draws itself across when it scrolls into view.
export interface Props {
  start?: string;
  label?: string;
  end?: string;
  tone?: 'dark' | 'light';
  class?: string;
}

const { start, label, end, tone = 'dark', class: className = '' } = Astro.props;
---

<div class:list={['measure', `measure-${tone}`, className]} data-measure aria-hidden={!start && !label && !end ? 'true' : undefined}>
  <span class="tick tick-start"></span>
  <span class="rule"></span>
  <span class="tick tick-end"></span>
  {start && <span class="note note-start">{start}</span>}
  {label && <span class="note note-mid">{label}</span>}
  {end && <span class="note note-end">{end}</span>}
</div>

<style>
  .measure {
    position: relative;
    height: 2.25rem;
    color: rgb(31 33 23 / 0.35);
  }
  .measure-light {
    color: rgb(252 249 243 / 0.35);
  }
  .rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    transition: transform 1.4s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .tick {
    position: absolute;
    top: calc(50% - 6px);
    width: 1px;
    height: 12px;
    background: currentColor;
    transition: transform 0.4s ease;
  }
  .tick-start {
    left: 0;
  }
  .tick-end {
    right: 0;
    transition-delay: 1.2s;
  }
  .note {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    padding: 0 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgb(31 33 23 / 0.6);
    background: var(--measure-bg, #fcf9f3);
    transition: opacity 0.6s ease 0.6s;
  }
  .measure-light .note {
    color: rgb(252 249 243 / 0.65);
  }
  .note-start {
    left: 1rem;
  }
  .note-mid {
    left: 50%;
    translate: -50% -50%;
  }
  .note-end {
    right: 1rem;
  }

  :global(.js) .measure:not(.is-in) .rule {
    transform: scaleX(0);
  }
  :global(.js) .measure:not(.is-in) .tick {
    transform: scaleY(0);
  }
  :global(.js) .measure:not(.is-in) .note {
    opacity: 0;
  }

  @media (max-width: 640px) {
    .note-mid {
      display: none;
    }
    .note {
      font-size: 0.62rem;
      letter-spacing: 0.12em;
      padding: 0 0.5rem;
    }
    .note-start {
      left: 0.5rem;
    }
    .note-end {
      right: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rule,
    .tick,
    .note {
      transition: none;
    }
  }
</style>
