---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  schema?: Record<string, unknown>;
}

const seo = Astro.props;
---

<BaseLayout {...seo}>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</BaseLayout>
