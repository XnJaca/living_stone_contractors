---
import MainLayout from '../../layouts/MainLayout.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { marked } from 'marked';
import { LICENSES, cld, getContact, getServices, hoursLines, normalizeRich, serviceHref, slugMatches, telHref, titleCase } from '../../lib/api';

const { slug } = Astro.params;
const [services, contact] = await Promise.all([getServices(), getContact()]);
const service = services.find((s) => slugMatches(s.slug, slug));

if (!service) {
  return Astro.redirect('/404');
}

const name = titleCase(service.title);
const others = services.filter((s) => s.id !== service.id).slice(0, 3);

// Content from the admin is HTML; older entries may still be Markdown.
let contentHtml = service.content || '';
if (contentHtml && !/<[a-z][\s\S]*>/i.test(contentHtml)) {
  contentHtml = await marked(contentHtml);
}
contentHtml = normalizeRich(contentHtml);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${name} Remodeling & Renovation`,
  serviceType: name,
  description: service.description,
  image: service.image,
  url: new URL(serviceHref(service), Astro.site).href,
  areaServed: { '@type': 'State', name: 'Maryland' },
  provider: { '@id': `${Astro.site}#business` },
};
---

<MainLayout
  title={service.metaTitle?.split('|')[0].trim() || `${name} Services`}
  description={service.metaDescription || service.description}
  image={cld(service.image, 1200)}
  canonicalURL={new URL(serviceHref(service), Astro.site).href}
  schema={schema}
>
  <PageHero
    eyebrow={`Services · ${name}`}
    title={name}
    lead={service.description}
    image={service.image}
    imageAlt={`${name} project by Living Stone Contractors`}
    measure={{ start: 'Maryland & DMV', end: 'Licensed & insured' }}
  />

  <section class="section pt-14 md:pt-20">
    <div class="container-site grid gap-14 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-20">
      <article class="rich reveal max-w-3xl" set:html={contentHtml} />

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="reveal rounded-lg border border-ink/10 bg-white p-7" style="--delay:120ms">
          <h2 class="!text-2xl">Get a free estimate</h2>
          <p class="mt-3 text-secondary-600">Tell us about your {name.toLowerCase()} project and we will follow up with next steps.</p>
          <a href="/contact" class="btn btn-primary mt-6 w-full">
            Request an estimate
            <Icon name="arrow" size={18} />
          </a>
          <a href={telHref(contact.phone)} class="btn btn-ghost mt-3 w-full">
            <Icon name="phone" size={18} />
            {contact.phone}
          </a>
          <dl class="mt-7 space-y-4 border-t border-ink/10 pt-6 text-sm">
            {
              LICENSES.map((l) => (
                <div class="flex justify-between gap-4">
                  <dt class="text-secondary-500">{l.label} License</dt>
                  <dd class="font-semibold tabular-nums">#{l.number}</dd>
                </div>
              ))
            }
            <div>
              <dt class="text-secondary-500">Hours</dt>
              {hoursLines(contact.hours).map((line) => <dd class="mt-1 font-medium">{line}</dd>)}
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="pb-20 md:pb-28">
        <div class="container-site">
          <h2 class="reveal !text-2xl md:!text-3xl">Other services</h2>
          <div class="mt-8 grid gap-px overflow-hidden rounded-lg border border-ink/10 bg-ink/10 md:grid-cols-3">
            {others.map((s) => (
              <a href={serviceHref(s)} class="group flex items-center justify-between gap-6 bg-cream p-7 transition-colors hover:bg-white">
                <span>
                  <span class="block text-xl font-semibold">{titleCase(s.title)}</span>
                  <span class="mt-1 line-clamp-2 block text-sm text-secondary-600">{s.description}</span>
                </span>
                <Icon name="arrow" size={20} class="shrink-0 transition-transform group-hover:translate-x-1" />
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTABand />
</MainLayout>
