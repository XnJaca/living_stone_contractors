---
import MainLayout from '../layouts/MainLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { LICENSES, SERVICE_AREA, getContact, getServices, hoursLines, serviceLists, telHref, titleCase } from '../lib/api';

const [contact, services] = await Promise.all([getContact(), getServices()]);

// Project types come from the service lists maintained in the admin.
const groups = services.map((s) => ({
  label: titleCase(s.title),
  options: serviceLists(s.content)
    .filter((g) => !/why choose|process/i.test(g.heading))
    .flatMap((g) => g.items),
}));
---

<MainLayout
  title="Contact Us | Free Estimate"
  description="Contact Living Stone Contractors for a free estimate on home remodeling or commercial renovation in Maryland and the DMV. Call (202) 373-8568 or send us your project details."
>
  <PageHero
    eyebrow="Contact"
    title="Let's plan your project."
    lead="Ready to start? Send us a few details and we will get back to you to schedule a consultation and free estimate."
    measure={{ start: 'Free estimates', end: 'Licensed & insured' }}
  />

  <section class="section pt-14 md:pt-20">
    <div class="container-site grid gap-14 lg:grid-cols-[1.25fr_1fr] lg:gap-20">
      <form action="https://formspree.io/f/mldzgdzl" method="POST" class="reveal grid gap-6 sm:grid-cols-2">
        <input type="hidden" name="_subject" value="New estimate request from livingstonecontractorsllc.com" />
        <div>
          <label for="firstName" class="label">First name</label>
          <input id="firstName" name="firstName" type="text" required autocomplete="given-name" class="field" />
        </div>
        <div>
          <label for="lastName" class="label">Last name</label>
          <input id="lastName" name="lastName" type="text" required autocomplete="family-name" class="field" />
        </div>
        <div>
          <label for="email" class="label">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="field" />
        </div>
        <div>
          <label for="phone" class="label">Phone</label>
          <input id="phone" name="phone" type="tel" required autocomplete="tel" class="field" />
        </div>
        <div class="sm:col-span-2">
          <label for="service" class="label">Project type</label>
          <select id="service" name="service" required class="field">
            <option value="">Select a project type</option>
            {
              groups.map((g) => (
                <optgroup label={g.label}>
                  {g.options.map((o) => <option value={`${g.label}: ${o}`}>{o}</option>)}
                  <option value={`${g.label}: Other`}>Other {g.label.toLowerCase()} project</option>
                </optgroup>
              ))
            }
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="message" class="label">Project details</label>
          <textarea id="message" name="message" rows="6" required class="field resize-y" placeholder="Location, scope, and timeline"></textarea>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="btn btn-primary w-full sm:w-auto sm:px-10">
            Request a free estimate
            <Icon name="arrow" size={18} />
          </button>
        </div>
      </form>

      <aside class="space-y-10">
        <ul class="lay border-t border-ink/10">
          <li class="border-b border-ink/10 py-5" style="--i:0">
            <a href={telHref(contact.phone)} class="group flex items-center gap-4">
              <Icon name="phone" size={22} class="text-primary-600" />
              <span>
                <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-secondary-500">Phone</span>
                <span class="text-lg font-semibold group-hover:text-primary-700">{contact.phone}</span>
              </span>
            </a>
          </li>
          <li class="border-b border-ink/10 py-5" style="--i:1">
            <a href={`mailto:${contact.email}`} class="group flex items-center gap-4">
              <Icon name="mail" size={22} class="text-primary-600" />
              <span class="min-w-0">
                <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-secondary-500">Email</span>
                <span class="block break-all text-lg font-semibold group-hover:text-primary-700">{contact.email}</span>
              </span>
            </a>
          </li>
          <li class="flex items-center gap-4 border-b border-ink/10 py-5" style="--i:2">
            <Icon name="pin" size={22} class="text-primary-600" />
            <span>
              <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-secondary-500">Based in</span>
              <span class="text-lg font-semibold">{contact.address}</span>
            </span>
          </li>
          <li class="flex items-start gap-4 border-b border-ink/10 py-5" style="--i:3">
            <Icon name="clock" size={22} class="mt-1 text-primary-600" />
            <span>
              <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-secondary-500">Hours</span>
              {hoursLines(contact.hours).map((line) => <span class="block text-lg font-semibold">{line}</span>)}
            </span>
          </li>
        </ul>

        <div class="reveal">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-secondary-500">Service area</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {SERVICE_AREA.map((a) => <li class="rounded-full border border-ink/10 px-3 py-1 text-sm">{a}</li>)}
          </ul>
        </div>

        <dl class="reveal grid grid-cols-2 gap-3">
          {
            LICENSES.map((l) => (
              <div class="rounded-lg border border-ink/10 px-5 py-4">
                <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-secondary-500">{l.label} License</dt>
                <dd class="mt-1 text-lg font-semibold tabular-nums">#{l.number}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </section>
</MainLayout>
