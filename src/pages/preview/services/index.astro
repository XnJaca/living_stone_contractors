---
import MainLayout from '../../../renew/layouts/MainLayout.astro';
import CTABand from '../../../renew/components/CTABand.astro';
import Icon from '../../../renew/components/Icon.astro';
import PageHero from '../../../renew/components/PageHero.astro';
import { cld, cldSrcset, getServices, serviceHref, serviceLists, titleCase } from '../../../renew/lib/api';

const services = await getServices();
---

<MainLayout
  title="Remodeling & Commercial Renovation Services in Maryland"
  description="Residential remodeling and commercial renovation services in Maryland and the DMV: kitchens, baths, basements, office build-outs, framing, drywall, and ceilings."
>
  <PageHero
    eyebrow="Services"
    title="What we build."
    lead="Comprehensive and personalized solutions that transform your space into functional, modern, and durable places."
    measure={{ start: 'Residential', label: 'Maryland & DMV', end: 'Commercial' }}
  />

  <section class="section pt-12 md:pt-16">
    <div class="container-site grid gap-6 md:grid-cols-2">
      {
        services.map((service, i) => {
          const name = titleCase(service.title);
          const items = serviceLists(service.content)
            .filter((g) => !/why choose|process/i.test(g.heading))
            .flatMap((g) => g.items)
            .slice(0, 8);
          return (
            <a href={serviceHref(service)} class="group flex flex-col overflow-hidden rounded-lg border border-ink/10 bg-cream transition-colors hover:border-ink/25">
              <div class="rise overflow-hidden" style={`--delay:${i * 120}ms`}>
                <img
                  src={cld(service.image, 1000)}
                  srcset={cldSrcset(service.image, [600, 1000])}
                  sizes="(min-width: 768px) 46vw, 92vw"
                  alt={`${name} project by Living Stone Contractors`}
                  class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </div>
              <div class="flex flex-1 flex-col p-7 md:p-9">
                <div class="flex items-center gap-3 text-sm font-semibold text-primary-700">
                  <span class="tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                  <span class="h-px w-8 bg-current" />
                  <Icon name={/commerc/i.test(service.title) ? 'building' : 'home'} size={18} />
                </div>
                <h2 class="mt-4 !text-3xl">{name}</h2>
                <p class="mt-4 leading-relaxed text-secondary-600">{service.description}</p>
                {items.length > 0 && (
                  <ul class="mt-7 flex flex-wrap gap-2">
                    {items.map((item) => (
                      <li class="rounded-full border border-ink/10 px-3 py-1 text-sm text-secondary-700">{item}</li>
                    ))}
                  </ul>
                )}
                <span class="link-arrow mt-auto pt-8">
                  View {name.toLowerCase()} services
                  <Icon name="arrow" size={18} />
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <CTABand title="Not sure which service you need?" text="Contact us for a free consultation. We will help you define the scope and the best solution for your project." />
</MainLayout>
