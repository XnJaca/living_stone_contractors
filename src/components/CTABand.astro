---
import Icon from './Icon.astro';
import { SERVICE_AREA, getContact, telHref } from '../lib/api';

export interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ready to start your project?',
  text = 'Get a free, no-obligation estimate. Tell us about the space and we will walk you through scope, schedule, and budget.',
} = Astro.props;
const contact = await getContact();
---

<section class="pb-20 md:pb-28">
  <div class="container-site">
    <div class="cta relative overflow-hidden rounded-xl bg-primary-700 px-6 py-14 text-cream sm:px-12 md:py-20 lg:px-16">
      <img src="/images/brand/mark-white.webp" alt="" width="256" height="255" class="pointer-events-none absolute -right-16 -top-10 w-80 opacity-[0.07] md:w-[28rem]" loading="lazy" />

      <div class="relative grid gap-12 lg:grid-cols-[1.25fr_1fr] lg:items-end">
        <div>
          <h2 class="reveal !text-cream">{title}</h2>
          <p class="reveal mt-5 max-w-xl text-lg leading-relaxed text-cream/80" style="--delay:60ms">{text}</p>
          <div class="reveal mt-9 flex flex-col gap-3 sm:flex-row" style="--delay:120ms">
            <a href="/contact" class="btn bg-cream text-ink hover:bg-white">
              Get a Free Estimate
              <Icon name="arrow" size={18} />
            </a>
            <a href={telHref(contact.phone)} class="btn btn-ghost-light">
              <Icon name="phone" size={18} />
              {contact.phone}
            </a>
          </div>
        </div>

        <div class="reveal border-t border-cream/20 pt-8 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0" style="--delay:180ms">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cream/60">Serving Maryland & the DMV</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {SERVICE_AREA.map((area) => <li class="rounded-full border border-cream/20 px-3.5 py-1.5 text-sm">{area}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
